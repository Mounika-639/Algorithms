step-1: start
step-2: print "How many even numbers you want to print ? "
step-3: read Number
step-4: print "The even numbers up to "+ Number + " are "
step-5: Counter = 0
step-6: LastEvenNumber = (2 * Number)-2
step-7: if (Counter < LastEvenNumber -1):
          print Counter +", "
          Counter = Counter +2
          goto step-7
step-8: print LastEvenNumber + ".\n"
step-9: stop

