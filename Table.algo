step-1: start
step-2: print "Which multiplication table you want to print? "
step-3: read TableNumber
step-4: print "The multiplication table of "+ TableNumber + " is\n"
step-5: Counter = 1
step-6: if (Counter != 11)
           Multiple = TableNumber * Counter
           print TableNumber + " X " + Counter + " = " + Multiple +"\n"
           Counter = Counter + 1
           goto step- 6
step-7: stop

